{
  "name": "rsbuild-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Workers plugin for Rsbuild",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "rsbuild",
    "rsbuild-plugin",
    "workers"
  ],
  "homepage": "https://github.com/Nsttt/rsbuild-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/Nsttt/rsbuild-cloudflare/issues"
  },
  "license": "MIT",
  "author": "Nestor Lopez <nestor@nstlopez.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nsttt/rsbuild-cloudflare.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "changeset": "changeset",
    "check": "pnpm check:format && pnpm check:type && pnpm test:ci && pnpm build",
    "check:format": "oxfmt --check .",
    "check:type": "tsc --build",
    "dev": "rslib --watch",
    "examples:build": "pnpm --dir examples build",
    "examples:check:type": "pnpm --dir examples check:type",
    "format": "oxfmt .",
    "lint": "pnpm lint:rslint",
    "lint:rslint": "rslint --tsconfig tsconfig.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm release:check",
    "publish:dry-run": "pnpm publish --dry-run --no-git-checks",
    "release:check": "pnpm check && pnpm examples:check:type && pnpm examples:build && pnpm pack --dry-run",
    "release:publish": "changeset publish",
    "release:version": "changeset version",
    "test": "vitest run",
    "test:ci": "pnpm test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "miniflare": "^4.20260603.0",
    "wrangler": "^4.98.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/workers-types": "^4.20260603.1",
    "@microsoft/api-extractor": "^7.52.8",
    "@rsbuild/core": "2.0.9",
    "@rslib/core": "0.22.0",
    "@rslint/cli": "^0.0.1",
    "@types/node": "22.15.17",
    "oxfmt": "^0.53.0",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "wrangler": "^4.98.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
